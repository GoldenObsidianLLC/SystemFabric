# Core
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
VIRGOSCORPIO_HUB_API_TOKEN=replace-with-a-long-random-development-token
VIRGOSCORPIO_HUB_LOG_LEVEL=info
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Real-time Foundation 1 is an opt-in preview. Redis shares presence leases,
# ephemeral presence-refresh fan-out and connection-quota leases in Redis mode.
# WebSocket presence and SSE fallback use the same limits. PostgreSQL remains the durable event source.
VIRGOSCORPIO_HUB_REALTIME_ENABLED=false
VIRGOSCORPIO_HUB_PRESENCE_STORE=memory
VIRGOSCORPIO_HUB_PRESENCE_REDIS_URL=redis://127.0.0.1:6379
VIRGOSCORPIO_HUB_PRESENCE_LEASE_MS=30000
VIRGOSCORPIO_HUB_PRESENCE_MAX_SESSIONS_PER_SITE=10000
VIRGOSCORPIO_HUB_PRESENCE_EXPIRY_RETENTION_MS=30000
VIRGOSCORPIO_HUB_REALTIME_MAX_CONNECTIONS=10000
VIRGOSCORPIO_HUB_REALTIME_MAX_CONNECTIONS_PER_SITE=500
VIRGOSCORPIO_HUB_REALTIME_MAX_CONNECTIONS_PER_PRINCIPAL=4
VIRGOSCORPIO_HUB_REALTIME_CONNECTION_LEASE_MS=45000

# PostgreSQL is authoritative for content and configuration.
DATABASE_URL=postgres://virgoscorpio_hub:virgoscorpio_hub_dev@127.0.0.1:5432/virgoscorpio_hub
DATABASE_POOL_MAX=10
VIRGOSCORPIO_HUB_DEFAULT_SITE_ID=
SESSION_IDLE_TTL_MINUTES=60

# Memgraph is a relationship projection, not the authoritative content store.
MEMGRAPH_URL=bolt://127.0.0.1:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_ENABLED=false

# AI provider: mock | openai-responses | openai-compatible | anthropic | gemini
AI_PROVIDER=mock
AI_MODEL=gpt-6-astra
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_PROMPT_CHARS=20000
AI_USE_STRICT_JSON_SCHEMA=true
OPENAI_COMPATIBLE_STRICT_JSON_SCHEMA=false
# External AI providers receive submitted prompts/content only after explicit opt-in.
AI_ALLOW_EXTERNAL_CONTENT=false
AI_ALLOWED_PROVIDERS=mock
AI_LOG_PROMPTS=false
AI_POLICY_DEFAULT_ENABLED=false
AI_POLICY_REQUIRE_HUMAN_REVIEW=true

# OpenAI Responses API (AI_PROVIDER=openai-responses)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra

# OpenAI-compatible Chat Completions API (vLLM / Ollama-compatible gateways / LM Studio)
# Example: http://127.0.0.1:11434/v1

# Anthropic Messages API (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini API (AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Identity/session. In production, SESSION_COOKIE_SECURE must be true behind HTTPS.
REQUIRE_VERIFIED_EMAIL=false
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Optional OIDC SSO (all values must come from your IdP registration).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
VIRGOSCORPIO_HUB_BOOTSTRAP_SECRET=replace-with-a-long-random-one-time-bootstrap-secret
VIRGOSCORPIO_HUB_ADMIN_EMAIL=admin@example.test
VIRGOSCORPIO_HUB_ADMIN_PASSWORD=ChangeThisDevelopmentPassword9
VIRGOSCORPIO_HUB_ADMIN_DISPLAY_NAME=VirgoScorpio Hub Owner
VIRGOSCORPIO_HUB_ADMIN_SITE_SLUG=main
VIRGOSCORPIO_HUB_ADMIN_SITE_NAME=Main Site

# Content/media storage: local | s3 (S3-compatible endpoints such as MinIO are supported)
MEDIA_DRIVER=local
MEDIA_ROOT=./var/media
S3_BUCKET=virgoscorpio-hub-assets
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=
MEDIA_CDN_PUBLIC=false

# Identity federation. OIDC remains separately configured; SAML is disabled by default.
SAML_ENABLED=false
SAML_IDP_ENTRY_POINT=
SAML_IDP_ISSUER=
SAML_IDP_CERT=
SAML_SP_ISSUER=
SAML_ACS_URL=
# Optional SP signing key pair for signed AuthnRequests. Store private key as a secret.
SAML_EMAIL_ATTRIBUTE=email
SAML_SP_PRIVATE_KEY=
SAML_SP_PUBLIC_CERT=
# Legacy alias for the public certificate; configure SAML_SP_PRIVATE_KEY as well.
SAML_SP_CERT=

# Asynchronous account mail delivery: disabled | resend | sendgrid
VIRGOSCORPIO_HUB_MAIL_PROVIDER=disabled
VIRGOSCORPIO_HUB_MAIL_FROM=no-reply@example.test
RESEND_API_KEY=
SENDGRID_API_KEY=

# Request-scoped W3C Trace Context v00. Trust upstream traceparent only behind a
# trusted ingress that strips client values and writes its own validated header.
VIRGOSCORPIO_HUB_TRACE_CONTEXT_TRUST_REMOTE=false
# Optional normalized, redacted API request-completion events.
VIRGOSCORPIO_HUB_HTTP_ACCESS_LOGS_ENABLED=false

# Optional manual OpenTelemetry spans with OTLP/HTTP export. Disabled by default.
# Use a private HTTPS collector endpoint. Root URLs are normalized to /v1/traces.
# Exporter headers accept only authorization and x-api-key; inject via a secret manager.
VIRGOSCORPIO_HUB_OTEL_ENABLED=false
VIRGOSCORPIO_HUB_OTEL_EXPORTER_ENDPOINT=
VIRGOSCORPIO_HUB_OTEL_EXPORTER_HEADERS_JSON=
VIRGOSCORPIO_HUB_OTEL_SAMPLE_RATIO=0.1
VIRGOSCORPIO_HUB_OTEL_EXPORT_TIMEOUT_MS=5000
# Permit HTTP only for a deliberately isolated development/private collector.
VIRGOSCORPIO_HUB_OTEL_ALLOW_INSECURE_HTTP=false

# Optional, redacted structured-log export via OTLP/HTTP. Independent of trace export.
# Disabled by default; use a private HTTPS collector endpoint ending in /v1/logs.
# A separate header secret may be injected here; when unset, trace exporter headers are reused.
VIRGOSCORPIO_HUB_OTEL_LOGS_ENABLED=false
VIRGOSCORPIO_HUB_OTEL_LOGS_EXPORTER_ENDPOINT=
VIRGOSCORPIO_HUB_OTEL_LOGS_EXPORTER_HEADERS_JSON=

# Background jobs
VIRGOSCORPIO_HUB_SCHEDULER_INTERVAL_MS=5000
VIRGOSCORPIO_HUB_METRICS_ENABLED=false
VIRGOSCORPIO_HUB_METRICS_TOKEN=

# Third-party plugin runner: keep private, use a unique secret of at least 32 characters.
VIRGOSCORPIO_HUB_PLUGIN_RUNNER_URL=
VIRGOSCORPIO_HUB_PLUGIN_TIMEOUT_MS=8000
PLUGIN_RUNNER_ALLOW_HTTP_INTERNAL=false
VIRGOSCORPIO_HUB_CONTAINER_RUNTIME=docker
VIRGOSCORPIO_HUB_PLUGIN_ALLOWED_IMAGES=
VIRGOSCORPIO_HUB_PLUGIN_EXECUTION_ENABLED=false
# JSON object mapping key IDs to Ed25519 public-key PEM strings. Keep private signing keys off this service.
VIRGOSCORPIO_HUB_PLUGIN_TRUSTED_PUBLIC_KEYS={}
VIRGOSCORPIO_HUB_PLUGIN_REQUIRE_SBOM=true
VIRGOSCORPIO_HUB_PLUGIN_REQUIRE_INDEPENDENT_REVIEW=true
PLUGIN_RUNNER_HOST=127.0.0.1
PLUGIN_RUNNER_PORT=9090
PLUGIN_RUNNER_TIMEOUT_MS=5000

# Unified File/Document/Media Library
LIBRARY_STORAGE_PROVIDER=local
LIBRARY_ROOT=./var/library
VIRGOSCORPIO_HUB_LIBRARY_MAX_FILE_BYTES=52428800
LIBRARY_STORAGE_BUCKET=
LIBRARY_STORAGE_ENDPOINT=
# Production custom endpoints require an exact host[:port] match in this list.
VIRGOSCORPIO_HUB_CLOUD_ENDPOINT_ALLOWLIST=
LIBRARY_STORAGE_REGION=us-east-1
LIBRARY_STORAGE_CONTAINER=
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
AZURE_STORAGE_CONTAINER=
# AZURE_STORAGE_CONNECTION_STRING should be injected by deployment secret manager, never committed.

# Commerce and memberships (Stripe-hosted Checkout; no card data is stored here)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:8787/checkout/success
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:8787/checkout/cancel

# Application-level firewall. For example: 192.0.2.44,198.51.100.0/24
VIRGOSCORPIO_HUB_FIREWALL_DENY_CIDRS=

# Optional media derivatives
VIRGOSCORPIO_HUB_MEDIA_OPTIMIZER_MAX_BYTES=52428800
VIRGOSCORPIO_HUB_VIDEO_OPTIMIZER_MAX_BYTES=104857600

# Upload scanning. Production uploads fail closed if malware scanning is not configured.
# Set LIBRARY_MALWARE_SCANNER=clamdscan only after installing/configuring ClamAV.
LIBRARY_MALWARE_SCANNER=
CLAMDSCAN_PATH=clamdscan
LIBRARY_MALWARE_SCAN_TIMEOUT_MS=20000

# Integration tests MUST use the dedicated test database, never a production DB.
# In local-host mode, Docker Compose exposes PostgreSQL and Memgraph on loopback.
TEST_DATABASE_URL=postgres://virgoscorpio_hub:virgoscorpio_hub_dev@127.0.0.1:5432/virgoscorpio_hub_test
MEMGRAPH_TEST_URL=bolt://127.0.0.1:7687


# Durable graph projection consumer group (default values shown).
VIRGOSCORPIO_HUB_GRAPH_CONSUMER_GROUP=graph.projection.v1
VIRGOSCORPIO_HUB_GRAPH_BATCH_SIZE=25
VIRGOSCORPIO_HUB_GRAPH_DISPATCH_BATCH_SIZE=250
VIRGOSCORPIO_HUB_GRAPH_LEASE_MS=30000
VIRGOSCORPIO_HUB_GRAPH_MAX_ATTEMPTS=10
VIRGOSCORPIO_HUB_GRAPH_POLL_MS=1000

# Optional OpenTelemetry trace export. Disabled by default; configure credentials
# through the deployment secret manager, never in committed environment examples.
VIRGOSCORPIO_HUB_OTEL_ENABLED=false
VIRGOSCORPIO_HUB_OTEL_EXPORTER_ENDPOINT=
VIRGOSCORPIO_HUB_OTEL_EXPORTER_HEADERS_JSON=
VIRGOSCORPIO_HUB_OTEL_SAMPLE_RATIO=0.1
VIRGOSCORPIO_HUB_OTEL_EXPORT_TIMEOUT_MS=5000
VIRGOSCORPIO_HUB_OTEL_ALLOW_INSECURE_HTTP=false
# Docker Compose local observability profile secret file (created by npm run otel:dev:setup).
VIRGOSCORPIO_HUB_OTEL_AUTH_TOKEN_FILE=./var/secrets/otel-collector-token.txt
VIRGOSCORPIO_HUB_OTEL_COLLECTOR_IMAGE_TAG=0.164.0-amd64
