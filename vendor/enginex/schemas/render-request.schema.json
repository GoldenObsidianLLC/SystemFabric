{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnginEx RenderRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "traceId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?($|/))[^\\\\\\u0000]+$"
    },
    "mode": {
      "enum": [
        "sync",
        "async",
        "stream"
      ]
    },
    "profile": {
      "enum": [
        "standard-ssr",
        "high-throughput",
        "incremental-ui",
        "streaming",
        "ai-preview",
        "constrained-runtime"
      ]
    },
    "data": {},
    "options": {
      "type": "object"
    }
  }
}
