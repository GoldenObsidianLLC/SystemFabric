{
  "name": "virgoscorpio-hub",
  "version": "0.6.2",
  "private": true,
  "description": "AI-integrated headless CMS, visual page builder, media and document library, commerce, memberships, community, and rendering runtime for Node.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "node apps/api/src/server.js",
    "start:api": "node apps/api/src/server.js",
    "start:mcp": "node apps/mcp/src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/verify.js && npm test",
    "dev": "node apps/api/src/server.js",
    "seed:dev": "node scripts/seed-dev.js",
    "start:worker": "node apps/worker/src/outbox-worker.js",
    "migrate": "node scripts/migrate.js",
    "bootstrap:owner": "node scripts/bootstrap-owner.js",
    "plugin:provenance": "node scripts/plugin-provenance.js",
    "start:scheduler": "node apps/worker/src/scheduler.js",
    "start:plugin-runner": "node apps/plugin-runner/src/server.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:integration:live && npm run test:e2e",
    "sbom": "node scripts/generate-sbom.js",
    "postinstall": "node scripts/materialize-katex-assets.js",
    "reconcile:library": "node scripts/reconcile-library-objects.js",
    "release:readiness": "node scripts/release-readiness.js",
    "release:assert-ready": "node scripts/release-readiness.js --strict",
    "ci:evidence:stage": "node scripts/ci-evidence.js stage",
    "ci:evidence:aggregate": "node scripts/ci-evidence.js aggregate",
    "dev:setup": "node scripts/setup-dev.js",
    "dev:bootstrap": "node scripts/bootstrap-dev.js",
    "dev:doctor": "node scripts/dev-doctor.js",
    "otel:dev:setup": "node scripts/configure-otel-dev.js",
    "otel:dev:smoke": "node scripts/test-otel-collector.js",
    "observability:deployment:validate": "node scripts/validate-observability-deployment.js",
    "test:integration:live": "node scripts/test-integration-live.js",
    "test:integration:memgraph-outage": "node scripts/test-memgraph-outage.js",
    "test:e2e:install": "playwright install chromium",
    "test:graph:rebuild": "node scripts/test-graph-rebuild.js",
    "test:migrations:fresh": "node scripts/test-fresh-migrations.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@node-saml/node-saml": "5.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "enginex-ai-native": "file:vendor/enginex",
    "neo4j-driver": "6.0.1",
    "pg": "8.16.3",
    "redis": "6.3.1",
    "ws": "8.22.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "optionalDependencies": {
    "@azure/storage-blob": "12.34.0",
    "@google-cloud/storage": "8.4.0",
    "katex": "0.19.1",
    "sharp": "0.35.5"
  }
}
